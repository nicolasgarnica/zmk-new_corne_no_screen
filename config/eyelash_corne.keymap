/*
 * Nicolas's Corne keymap ported to the Eyelash Corne (48 keys + encoder).
 * Source: zmk-corne_no_display/config/corne.keymap
 *
 * The 42 Corne keys sit in the same places as on the Corne.
 * The 6 middle keys keep the vendor defaults on the base layer
 * (Up, Left, Enter, Right, Down, encoder press = Mute) and are
 * transparent on every other layer, so they work everywhere.
 * Encoder turns volume up and down on all layers.
 */

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/* ── Extended tapping-term timers ─────────────────────────────────────────── */

/* Mod-tap: Settings to try to reduce accidenta setting off of home row mods */
&mt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

/* Layer-tap: similar with what is setup for mod-tap */
&lt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/* ── Mouse / scroll tuning ────────────────────────────────────────────────── */

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        /* ── Custom behavior for homerow shift ────────────────────────────────────── */
        hs: homerow_shift {
            // For SHIFT only — snappy, keeps up with fast typing
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    /* Hold Q + S + Z for 2 s to power off (press reset to wake) */
    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC        &kp Q          &kp W          &kp E          &kp R          &kp T          &kp UP         &kp Y          &kp U          &kp I          &kp O          &kp P          &kp MINUS
&kp TAB        &mt LGUI A     &mt LALT S     &hs LSHFT D    &mt LCTRL F    &lt 1 G        &kp LEFT       &kp ENTER      &kp RIGHT      &kp H          &mt RCTRL J    &hs RSHFT K    &mt RALT L     &mt RGUI SEMI  &kp SQT
&kp CAPSLOCK   &kp Z          &kp X          &kp C          &kp V          &kp B          &kp C_MUTE     &kp DOWN       &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RA(LBKT)
                                             &to 1          &mo 2          &kp ENTER      &kp SPACE      &kp BSPC       &kp DEL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        lower_layer {
            display-name = "NAV";
            bindings = <
&trans           &none            &mkp RCLK        &mmv MOVE_UP     &mkp LCLK        &msc SCRL_UP     &trans           &kp PG_UP        &kp HOME         &kp UP           &kp END          &none            &trans
&trans           &msc SCRL_LEFT   &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &trans           &trans           &trans           &none            &kp LEFT         &kp DOWN         &kp RIGHT        &none            &trans
&trans           &kp LGUI         &kp LALT         &kp LSHFT        &kp LCTRL        &mmv MOVE_DOWN   &trans           &trans           &kp PG_DN        &kp RCTRL        &kp RSHFT        &kp RALT         &kp RGUI         &trans
                                                   &tog 3           &to 0            &kp ENTER        &kp SPACE        &trans           &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&kp GRAVE             &kp N1                &kp N2                &kp N3                &kp N4                &kp N5                &trans                &kp N6                &kp N7                &kp N8                &kp N9                &kp N0                &kp MINUS
&none                 &mt LGUI NON_US_BSLH  &mt LALT SQT          &mt LSHFT LBKT        &mt LCTRL MINUS       &none                 &trans                &trans                &trans                &none                 &mt RCTRL EQUAL       &mt RSHFT RBKT        &mt RALT BSLH         &mt RGUI INT_YEN      &none
&none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none
                                                                  &kp DEL               &trans                &kp ENTER             &kp SPACE             &kp BSPC              &kp DEL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&kp ESC          &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &trans           &kp F8           &kp F9           &kp F10          &kp F11          &kp F12          &kp BSPC
&bt BT_CLR       &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &none            &trans           &trans           &trans           &none            &rgb_ug RGB_EFR  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &none            &bt BT_CLR
&bootloader      &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &none            &trans           &trans           &none            &none            &none            &none            &none            &bootloader
                                                   &trans           &to 0            &kp ENTER        &kp SPACE        &trans           &kp BSPC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
